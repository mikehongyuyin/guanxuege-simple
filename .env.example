# 观学阁 · 环境变量示例
# 使用方式：复制为 .env 后按实际环境修改（.env 已被 .gitignore 忽略）
#
#   cp .env.example .env

# ============================================================
# JWT 签名密钥（HS256 要求 >= 32 字符，即 >= 256 bit）
# 泄露等同于任何人可伪造登录凭证，生产环境必须单独设置
# 生成方式：openssl rand -base64 48
# ============================================================
JWT_SECRET=please-replace-with-a-random-string-at-least-32-chars

# ============================================================
# 数据库连接（容器部署时由 compose 注入，通常无需改动）
# ============================================================
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASSWORD=123456

# ============================================================
# 图片上传目录（容器内为 /app/images，已做持久化挂载）
# ============================================================
APP_UPLOAD_DIR=./images
